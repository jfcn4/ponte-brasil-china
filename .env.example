# Endereço da aplicação usado nos links e QR codes (sem barra final).
# Na Vercel, configure o endereço público de produção. Para escanear o QR de
# um celular na mesma rede durante o desenvolvimento, use o IP da máquina
# (ex.: http://192.168.0.10:3000) e rode `npm run dev -- -H 0.0.0.0`.
APP_URL=http://localhost:3000

# Supabase: URL do projeto e chave publicável (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: chave privada do servidor (sb_secret_...).
SUPABASE_SECRET_KEY=

# Nome do bucket de fotos a criar no Supabase Storage.
SUPABASE_STORAGE_BUCKET=product-images

# Conexão PostgreSQL usada só pelas migrações (npm run db:migrate).
# Em redes só IPv4, use a URI do Session pooler (Supabase → Connect → Session pooler):
# postgresql://postgres.<projeto>:<senha>@aws-<n>-<região>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Gemini: chave privada do servidor e identificador do modelo Flash escolhido.
GEMINI_API_KEY=
GEMINI_MODEL=

# IA: "gemini" (padrão) chama a API real; "test" usa respostas fixas, sem cota,
# identificadas na tela como teste. Os testes E2E sobem o servidor com "test".
AI_MODE=
